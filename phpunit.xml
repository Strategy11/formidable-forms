<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	backupGlobals="false"
	backupStaticProperties="false"
	bootstrap="tests/phpunit/bootstrap.php"
	colors="true"
	cacheDirectory=".phpunit.cache"
	>
	<testsuites>
		<testsuite name="default">
			<directory prefix="test_" suffix=".php">./tests/phpunit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">./classes</directory>
			<directory suffix=".php">./paypal</directory>
			<directory suffix=".php">./square</directory>
			<directory suffix=".php">./stripe</directory>
			<file>formidable.php</file>
		</include>
		<exclude>
			<directory suffix=".php">./classes/views</directory>
			<directory suffix=".php">./paypal/views</directory>
			<directory suffix=".php">./square/views</directory>
			<directory suffix=".php">./stripe/views</directory>
			<directory suffix=".php">./deprecated</directory>
		</exclude>
	</source>
	<coverage includeUncoveredFiles="true" ignoreDeprecatedCodeUnits="true" />
</phpunit>
